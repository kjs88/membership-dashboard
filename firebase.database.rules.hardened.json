{
  "rules": {
    ".read": "auth != null",
    ".write": false,
    "erp": {
      "latest": {
        ".read": "auth != null",
        ".write": "auth.token.admin === true",
        ".validate": "newData.hasChildren(['order', 'ship', 'syncedAt'])"
      }
    },
    "data": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true"
    }
  }
}
